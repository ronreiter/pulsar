// Sept Marches: minimalist solo piano. D minor, 108 BPM, ~2 minutes.
// An original melody over a left hand that never stops: it starts as a single line, thickens
// into octaves, breaks into sixteenths, then is left with the left hand alone. All the drama
// is touch and doubling; there is nothing here but one grand piano in a small room.
tempo 108
key "D minor"
seed 57
loudness -16

bus room = reverb(decay: 1.5, size: 0.5, damp: 0.55, predelay: 0.01)

track left  = piano("grand", pedal: 0.08, room: 0.3, gain: -1, humanize: 6) >> hp(50) >> eq(mid: 1.5, mid_freq: 2500, high: 6, high_freq: 4500)
track right = piano("grand", pedal: 0.12, room: 0.3, pan: 0.06, gain: 2, humanize: 7) >> hp(90) >> eq(mid: 2, mid_freq: 2500, high: 7, high_freq: 4500)

let lh = "<[d2 a2 f3 a3 d4 a3 f3 a2] [f2 c3 a3 c4 f4 c4 a3 c3] [c2 g2 e3 g3 c4 g3 e3 g2] [g1 d2 bb2 d3 g3 d3 bb2 d2]>"
let pulse_vel = "[.68 .44 .5 .46 .58 .44 .5 .44]"
let line_a = "<[a4 _ a4 _ d5 _ c5 a4] [c5 _ c5 _ f5 _ e5 c5] [g4 _ g4 _ e5 _ d5 c5] [bb4 _ a4 _ g4 _ _ _]>"
let line_b = "<[f5 _ e5 f5 a5 _ f5 _] [a5 _ g5 a5 c6 _ a5 _] [g5 _ e5 g5 c6 _ g5 _] [bb5 _ a5 g5 d5 _ _ _]>"
let shimmer = "<Dm F C Gm>".arp("updown", 1/16, 2).octave(5).vel("[.62 .4 .44 .4]*4")
fn doubled(p) = p.stack(p.oct(-1))

section steps 4 {
  play left lh.vel(pulse_vel).velscale(0.8)
}
section one_hand 8 {
  play left lh.vel(pulse_vel).velscale(0.85)
  play right line_a.vel(0.56)
}
section two_hands 8 {
  play left lh.vel(pulse_vel)
  play right doubled(line_a).vel(0.66)
}
section upward 8 {
  play left lh.vel(pulse_vel).velscale(1.08)
  play right doubled(line_b).vel(0.74)
}
section falling 8 {
  play left lh.vel(pulse_vel).velscale(0.9)
  play right shimmer.velscale(0.9)
}
section all_in 8 {
  play left lh.vel(pulse_vel).velscale(1.2)
  play right shimmer.velscale(0.8)
  play right doubled(line_b).vel(0.9)
}
section again 8 {
  play left lh.vel(pulse_vel).velscale(1.2)
  play right doubled(line_a).oct(1).vel(0.86)
  play right doubled(line_a).vel(0.72)
}
section alone 8 {
  play left lh.vel(pulse_vel).velscale(0.75) to 6
  play right line_a.vel(0.46) to 4
  play left "[d1,d2,a2,f3,d4]".slow(2).vel(0.48) from 6
  automate master.gain 0 -> -6 from 4
}
arrange steps, one_hand, two_hands, upward, falling, all_in, again, alone
