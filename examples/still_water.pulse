// Still Water: relaxing spa music. D major, 64 BPM, ~4 minutes.
// A sampled grand piano, played softly over slow pads, with a real dawn chorus and a trickling
// stream under everything.
// The birds and the water are free stock recordings found by ambience() -- `pulsar sounds "birds"`
// lists the candidates -- and the render writes still_water.credits.txt with who recorded them.
tempo 64
key "D major"
seed 3
loudness -16

bus hall = reverb(decay: 6, size: 0.95, damp: 0.5, predelay: 0.04)

// ---- the room: birds and water ----------------------------------------------------------------
track birds = ambience("dawn chorus", id: "File:Dawn chorus at Glencairnie big bungalow Craigmore DM.ogg",
                       fade: 8, width: 1.3, gain: -6)
  >> hp(300) >> comp(threshold: -30, ratio: 2.5, attack: 0.005, release: 0.2, makeup: 11) >> eq(high: -3)
track water = ambience("water trickle", id: "File:363120 fractalstudios water-trickle.wav", fade: 8,
                       width: 1.2, gain: -7) >> hp(160) >> lp(9000)

// ---- piano: a sampled Yamaha C5 grand, played softly ------------------------------------------
track keys   = piano("grand", pedal: 0.4, hall: 0.4, gain: 0) >> hp(80) >> eq(low: -3.5)
track melody = piano("grand", pedal: 0.6, hall: 0.45, pan: 0.08, gain: 6)
  >> delay(3/8, feedback: 0.25, mix: 0.08, tone: 0.4, pingpong: 1)

// ---- air: pads, a low cello-ish drone, glass bells --------------------------------------------
track pad   = synth("pad", attack: 3, release: 5, cutoff: 0.22, width: 1.7, hall: 0.6, gain: -5, octave: 3)
  >> hp(260) >> chorus(0.35)
track glass = synth("glass_pad", attack: 4, release: 6, hall: 0.7, width: 1.5, gain: -8)
track low   = synth("strings", attack: 2.5, release: 4, cutoff: 0.25, hall: 0.4, gain: -6, octave: 2) >> lp(900)
track bell  = synth("bell", decay: 6, release: 4, hall: 0.8, pan: -0.25, gain: 1)

// ---- material ----------------------------------------------------------------------------------
let prog_home = "<Dmaj9 Gmaj9 Em9 Asus4>"
let prog_away = "<Bm9 Gmaj9 Dmaj9 Asus2>"
let roots_home = "<d2 g1 e2 a1>"
let roots_away = "<b1 g1 d2 a1>"
// left hand holds the root, right hand rolls the chord slowly upward and back
fn roll(prog) = prog.voicing("smooth").arp("updown", 1/8, 1).vel("0.7 0.5 0.6 0.5")
let theme = "<[a5 _ _ f#5 _ _ e5 _] [d5 _ _ _ ~ ~ ~ ~] [e5 _ _ g5 _ _ f#5 _] [e5 _ _ _ ~ ~ ~ ~] [a5 _ _ c#6 _ _ a5 _] [b5 _ _ _ a5 _ _ _] [g5 _ _ f#5 _ _ e5 _] [d5 _ _ _ _ _ ~ ~]>"
let reply = "<[f#5 _ _ _ d5 _ _ _] [d5 _ _ e5 _ _ b4 _] [a4 _ _ _ ~ ~ ~ ~] [c#5 _ _ _ e5 _ _ _] [f#5 _ _ _ d5 _ _ _] [b5 _ _ a5 _ _ g5 _] [f#5 _ _ _ e5 _ _ _] [e5 _ _ _ ~ ~ ~ ~]>"
let sparkle = "<[~ ~ ~ ~ a6 ~ ~ ~] ~ [~ ~ f#6 ~ ~ ~ ~ ~] ~>"

// ---- arrangement -------------------------------------------------------------------------------
section dawn 8 {
  play birds "x"
  play water "x"
  play pad prog_home.voicing("smooth") from 2
  play keys roll(prog_home) from 4
  automate pad.cutoff 0.12 -> 0.22 from 2
}

section first 16 {
  play birds "x"
  play water "x"
  play pad prog_home.voicing("smooth")
  play low roots_home.oct(1).legato(1)
  play keys roll(prog_home)
  play keys roots_home.legato(0.95).vel(0.55)
  play melody theme.vel("0.78 0.62") from 8
  play bell sparkle from 8
  automate birds.gain -6 -> -9 from 8
}

section away 16 {
  play birds "x"
  play water "x"
  play pad prog_away.voicing("smooth")
  play glass prog_away.voicing("smooth").legato(1)
  play low roots_away.oct(1).legato(1)
  play keys roll(prog_away)
  play keys roots_away.legato(0.95).vel(0.55)
  play melody reply.vel("0.74 0.6")
  automate pad.cutoff 0.22 -> 0.3
  automate birds.gain -9
}

section home 16 {
  play birds "x"
  play water "x"
  play pad prog_home.voicing("smooth")
  play glass prog_home.voicing("smooth").legato(1) to 8
  play low roots_home.oct(1).legato(1)
  play keys roll(prog_home)
  play keys roots_home.legato(0.95).vel(0.55)
  play melody theme.vel("0.82 0.64")
  play bell sparkle
  automate pad.cutoff 0.3 -> 0.2
  automate birds.gain -9 -> -6 from 8
}

section dusk 10 {
  play birds "x"
  play water "x"
  play pad prog_home.voicing("smooth") to 6
  play keys roll(prog_home) to 6
  play keys "<d2 g1 e2 a1>".legato(0.95).vel(0.5) to 6
  play keys "d3 a3 e4 f#4".legato(4).vel(0.5) at 6
  automate master.gain 0 -> -24 from 6
}

arrange dawn, first, away, home, dusk
